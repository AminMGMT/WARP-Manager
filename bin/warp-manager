#!/usr/bin/env bash
# WARP Manager - selective Cloudflare WARP routing for a VPS exit node.
# Routes chosen services (Google/Gemini, ChatGPT, ...) through WARP while the rest
# of the traffic keeps the server's normal IP. Transparent: no Xray/panel changes.
set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
WM_ROOT="${WM_ROOT:-$(dirname "$(dirname "$SELF")")}"
export WM_ROOT
# shellcheck source=/dev/null
for lib in common warp routing providers adblock ipcheck singbox automation presets; do
    src="${WM_ROOT}/lib/${lib}.sh"
    [[ -f "$src" ]] || { echo "Library not found: $src" >&2; exit 1; }
    source "$src"
done

# =========================================================================
# UI helpers
# =========================================================================
hr()  { printf '%s────────────────────────────────────────────────────────────%s\n' "$C_GRAY" "$C_RESET"; }
pause() { read -rp $'\n'"${C_DIM}Press Enter...${C_RESET}" _; }

banner() {
    clear 2>/dev/null || true
    printf '%s' "$C_PRIMARY"
    cat <<'EOF'
 ██╗    ██╗ █████╗ ██████╗ ██████╗     ███╗   ███╗ ██████╗ ██████╗
 ██║    ██║██╔══██╗██╔══██╗██╔══██╗    ████╗ ████║██╔════╝ ██╔══██╗
 ██║ █╗ ██║███████║██████╔╝██████╔╝    ██╔████╔██║██║  ███╗██████╔╝
 ██║███╗██║██╔══██║██╔══██╗██╔═══╝     ██║╚██╔╝██║██║   ██║██╔══██╗
 ╚███╔███╔╝██║  ██║██║  ██║██║         ██║ ╚═╝ ██║╚██████╔╝██║  ██║
  ╚══╝╚══╝ ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝         ╚═╝     ╚═╝ ╚═════╝ ╚═╝  ╚═╝
EOF
    printf '%s' "$C_RESET"
    printf '      %sSelective Cloudflare WARP routing for your VPS%s\n' "$C_GRAY" "$C_RESET"
    printf '      %sTeleGram : %s@BlackProtocols%s\n' "$C_GRAY" "$C_WHITE" "$C_RESET"
}

status_line() {
    local warp_state eng_state exit_ip
    if warp_is_up; then warp_state="${C_GREEN}● up${C_RESET}"; else warp_state="${C_RED}○ down${C_RESET}"; fi
    if singbox_is_up; then eng_state="${C_GREEN}● on${C_RESET}"; else eng_state="${C_RED}○ off${C_RESET}"; fi
    # header must be instant: read the cached exit IP, never probe the network here
    exit_ip="$(warp_exit_ip_cached)"
    hr
    printf ' %sWARP%s %-16b  %sEngine%s %-16b  %sExit IP%s %s\n' \
        "$C_PRIMARY$C_BOLD" "$C_RESET" "$warp_state" \
        "$C_PRIMARY$C_BOLD" "$C_RESET" "$eng_state" \
        "$C_PRIMARY$C_BOLD" "$C_RESET" "${exit_ip:-–}"
    hr
}

# =========================================================================
# Catalogue   (data/groups.conf: [Category] followed by one provider id per line)
# =========================================================================
group_names() { awk '/^\[.*\]$/ { gsub(/^\[|\]$/,""); print }' "$WM_GROUPS_FILE"; }

# ids of category N, in file order
group_members() {
    awk -v n="$1" '
        /^[[:space:]]*(#|$)/ { next }
        /^\[.*\]$/           { c++; next }
        c == n               { print $1 }
    ' "$WM_GROUPS_FILE"
}
# every id in the catalogue, once
all_ids() {
    awk '/^[[:space:]]*(#|$)|^\[.*\]$/ { next } { print $1 }' "$WM_GROUPS_FILE" | awk '!seen[$0]++'
}
# a service's label: the provider file is the single source of truth
display_name() {
    local n; n="$(prov_field "$1" name 2>/dev/null)"
    printf '%s' "${n:-$1}"
}

# --- enabled-state cache -------------------------------------------------
# The catalogue is ~100 services and every redraw asks the state of each one.
# Grepping enabled.list that many times is visibly slow on a small VPS, so the
# menu keeps the list in memory and writes it back in one go after a change.
declare -A WM_EN=()
sel_load() {
    WM_EN=()
    local id
    while read -r id; do
        [[ -n "$id" ]] && WM_EN["$id"]=1
    done < <(grep -vE '^[[:space:]]*(#|$)' "$WM_ENABLED_FILE" 2>/dev/null)
}
sel_save() {
    local id tmp="${WM_ENABLED_FILE}.tmp"
    : >"$tmp"
    for id in "${!WM_EN[@]}"; do printf '%s\n' "$id"; done | sort >"$tmp"
    mv -f "$tmp" "$WM_ENABLED_FILE"
}
sel_on()     { [[ -n "${WM_EN[$1]:-}" ]]; }
sel_set()    { WM_EN["$1"]=1; }
sel_unset()  { unset 'WM_EN[$1]'; }
sel_toggle() { if sel_on "$1"; then sel_unset "$1"; else sel_set "$1"; fi; }

# ON if every member is selected, off if none, PARTIAL in between
group_state() {
    local n="$1" total=0 on=0 id
    while read -r id; do
        [[ -z "$id" ]] && continue
        total=$((total+1)); sel_on "$id" && on=$((on+1))
    done < <(group_members "$n")
    if   [[ "$total" -eq 0 || "$on" -eq 0 ]]; then echo off
    elif [[ "$on" -eq "$total" ]]; then echo on
    else echo partial; fi
}
group_count() {   # "<on>/<total>"
    local n="$1" total=0 on=0 id
    while read -r id; do
        [[ -z "$id" ]] && continue
        total=$((total+1)); sel_on "$id" && on=$((on+1))
    done < <(group_members "$n")
    printf '%s/%s' "$on" "$total"
}
group_set_all() {   # <n> on|off
    local n="$1" want="$2" id
    while read -r id; do
        [[ -z "$id" ]] && continue
        [[ "$want" == on ]] && sel_set "$id" || sel_unset "$id"
    done < <(group_members "$n")
}

# --- small UI helpers ----------------------------------------------------
mark_of() {
    case "$1" in
        on)      printf '%s●%s' "$C_GREEN"  "$C_RESET" ;;
        partial) printf '%s◐%s' "$C_YELLOW" "$C_RESET" ;;
        *)       printf '%s○%s' "$C_GRAY"   "$C_RESET" ;;
    esac
}

# Turn "1 4 7", "1,4,7" and "2-9" into one valid index per line.
parse_nums() {
    local raw="${1//,/ }" max="$2" tok a b i
    for tok in $raw; do
        if [[ "$tok" =~ ^[0-9]+$ ]]; then
            (( tok >= 1 && tok <= max )) && printf '%s\n' "$tok"
        elif [[ "$tok" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            a="${BASH_REMATCH[1]}"; b="${BASH_REMATCH[2]}"
            (( a > b )) && { i="$a"; a="$b"; b="$i"; }
            for (( i = a; i <= b; i++ )); do
                (( i >= 1 && i <= max )) && printf '%s\n' "$i"
            done
        fi
    done
}

# What is currently routed, grouped by category and wrapped. Reads the file, not
# the menu cache, so it is also correct outside the Choose Services screen. With a
# large catalogue selected, one line per service would fill the whole screen.
enabled_summary() {
    local -a gnames
    mapfile -t gnames < <(group_names)
    local i=0 g id names any=0
    declare -A listed=()
    for g in "${gnames[@]}"; do
        i=$((i+1)); names=""
        while read -r id; do
            [[ -z "$id" ]] && continue
            [[ -f "$WM_PROVIDERS_DIR/${id}.conf" ]] || continue
            provider_is_enabled "$id" || continue
            listed["$id"]=1
            names+="${names:+, }$(display_name "$id")"
        done < <(group_members "$i")
        [[ -z "$names" ]] && continue
        any=1
        if [[ "$(group_members "$i" | wc -l)" -eq 1 ]]; then
            printf '   %s%s%s\n' "$C_WHITE" "$g" "$C_RESET"
        else
            printf '   %s%s%s\n' "$C_WHITE" "$g" "$C_RESET"
            printf '%s\n' "$names" | fold -s -w 66 | sed "s/^/     ${C_GRAY}/;s/\$/${C_RESET}/"
        fi
    done
    # anything enabled that no category claims (custom domains, a leftover id)
    names=""
    while read -r id; do
        [[ -z "$id" || -n "${listed[$id]:-}" ]] && continue
        [[ -f "$WM_PROVIDERS_DIR/${id}.conf" ]] || continue
        names+="${names:+, }$(display_name "$id")"
    done < <(grep -vE '^[[:space:]]*(#|$)' "$WM_ENABLED_FILE" 2>/dev/null)
    if [[ -n "$names" ]]; then
        any=1
        printf '   %sOther%s\n' "$C_WHITE" "$C_RESET"
        printf '%s\n' "$names" | fold -s -w 66 | sed "s/^/     ${C_GRAY}/;s/\$/${C_RESET}/"
    fi
    [[ "$any" -eq 0 ]] && printf '   %s(nothing selected — everything keeps the server IP)%s\n' "$C_DIM" "$C_RESET"
    return 0
}

# =========================================================================
# Choose services — categories, then the services inside one
# =========================================================================
# One category: numbered services, two columns when the list is long.
menu_category() {
    local n="$1" title="$2"
    local -a ids names
    mapfile -t ids < <(group_members "$n")
    local id w=0 name
    names=()
    for id in "${ids[@]}"; do
        name="$(display_name "$id")"
        names+=("$name")
        (( ${#name} > w )) && w=${#name}
    done
    local total=${#ids[@]}

    while true; do
        banner
        printf '\n %s%s%s   %s%s selected%s\n\n' \
            "$C_BOLD$C_PRIMARY" "$title" "$C_RESET" "$C_GRAY" "$(group_count "$n")" "$C_RESET"

        # two columns once the list no longer fits comfortably on one screen
        local cols=1 rows=$total
        if (( total > 12 )); then cols=2; rows=$(( (total + 1) / 2 )); fi
        local r c i label
        for (( r = 0; r < rows; r++ )); do
            printf ' '
            for (( c = 0; c < cols; c++ )); do
                i=$(( r + c * rows ))
                (( i >= total )) && continue
                # pad only while another column follows, so no line ends in blanks
                if (( r + (c + 1) * rows < total )); then
                    label="$(printf '%-*s' "$w" "${names[$i]}")"
                else
                    label="${names[$i]}"
                fi
                printf '  %s%2d%s %b %s%s%s' \
                    "$C_PRIMARY$C_BOLD" "$(( i + 1 ))" "$C_RESET" \
                    "$(sel_on "${ids[$i]}" && mark_of on || mark_of off)" \
                    "$C_WHITE" "$label" "$C_RESET"
            done
            printf '\n'
        done

        printf '\n %sNumbers%s toggle  %s(3   1 4 7   2-9)%s\n' \
            "$C_PRIMARY" "$C_RESET" "$C_DIM" "$C_RESET"
        printf ' %sa%s select all   %sn%s select none   %si%s invert   %s0%s back\n\n' \
            "$C_PRIMARY" "$C_RESET" "$C_PRIMARY" "$C_RESET" "$C_PRIMARY" "$C_RESET" "$C_PRIMARY" "$C_RESET"
        read -rp " > " ch
        case "$ch" in
            0|"")  sel_save; return ;;
            a|A)   group_set_all "$n" on ;;
            n|N)   group_set_all "$n" off ;;
            i|I)   for id in "${ids[@]}"; do sel_toggle "$id"; done ;;
            *)     while read -r i; do sel_toggle "${ids[$(( i - 1 ))]}"; done \
                       < <(parse_nums "$ch" "$total") ;;
        esac
        sel_save
    done
}

menu_services() {
    local -a gnames
    mapfile -t gnames < <(group_names)
    sel_load
    while true; do
        banner
        local total_on=0 total_all=0 id
        while read -r id; do
            total_all=$((total_all+1)); sel_on "$id" && total_on=$((total_on+1))
        done < <(all_ids)
        printf '\n %sChoose Services%s   %s%s of %s selected%s\n\n' \
            "$C_BOLD$C_PRIMARY" "$C_RESET" "$C_GRAY" "$total_on" "$total_all" "$C_RESET"

        local i=0 g st cnt single
        for g in "${gnames[@]}"; do
            i=$((i+1))
            st="$(group_state "$i")"
            cnt="$(group_count "$i")"
            single=0; [[ "${cnt#*/}" -eq 1 ]] && single=1
            if [[ "$single" -eq 1 ]]; then
                printf '  %s%2d%s %b %s%s%s\n' \
                    "$C_PRIMARY$C_BOLD" "$i" "$C_RESET" "$(mark_of "$st")" "$C_WHITE" "$g" "$C_RESET"
            else
                printf '  %s%2d%s %b %s%s%s %s%s%s\n' \
                    "$C_PRIMARY$C_BOLD" "$i" "$C_RESET" "$(mark_of "$st")" \
                    "$C_WHITE" "$(printf '%-38s' "$g")" "$C_RESET" "$C_GRAY" "$cnt" "$C_RESET"
            fi
        done

        printf '\n %sNumber%s open a category %s(single-service rows toggle directly)%s\n' \
            "$C_PRIMARY" "$C_RESET" "$C_DIM" "$C_RESET"
        printf ' %sa%s select everything   %sn%s select nothing   %s0%s back & apply\n\n' \
            "$C_PRIMARY" "$C_RESET" "$C_PRIMARY" "$C_RESET" "$C_PRIMARY" "$C_RESET"
        read -rp " > " ch
        case "$ch" in
            0|"") sel_save; apply_pretty; return ;;
            a|A)  while read -r id; do sel_set   "$id"; done < <(all_ids); sel_save ;;
            n|N)  while read -r id; do sel_unset "$id"; done < <(all_ids); sel_save ;;
            *[!0-9]*) : ;;
            *)
                if [[ "$ch" -ge 1 && "$ch" -le ${#gnames[@]} ]]; then
                    if [[ "$(group_count "$ch")" == */1 ]]; then
                        # a one-service category is a plain switch, not a submenu
                        sel_toggle "$(group_members "$ch" | head -n1)"; sel_save
                    else
                        menu_category "$ch" "${gnames[$(( ch - 1 ))]}"
                    fi
                fi ;;
        esac
    done
}

# =========================================================================
# Apply — show what is routed, then bring the engine to that state
# =========================================================================
# Add any custom domains as an extra provider-like file so sing-box picks them up.
_sync_custom_provider() {
    local cf="$WM_PROVIDERS_DIR/_custom.conf"
    if [[ -s "$WM_CUSTOM_FILE" ]] && grep -qvE '^[[:space:]]*(#|$)' "$WM_CUSTOM_FILE"; then
        local doms; doms="$(grep -vE '^[[:space:]]*(#|$)' "$WM_CUSTOM_FILE" | tr '\n' ' ')"
        printf 'id=_custom\nname=Custom domains\ntype=domain\ndomains=%s\n' "$doms" >"$cf"
        provider_enable "_custom"
    else
        rm -f "$cf"; provider_disable "_custom"
    fi
}

# Bring the whole engine to the desired state (WARP + sing-box + TPROXY).
# Order matters: sing-box must be up BEFORE the TPROXY rules, or 80/443 would break.
engine_apply() {
    warp_is_up || warp_up || return 1
    _sync_custom_provider
    singbox_reload || return 1
    routing_installed || routing_apply
    routing_load_exclusions
    watchdog_service_setup                   # fail-open guard: tunnel can never die
    ipcheck_timer_setup                      # auto exit-IP health check (if enabled)
    autorestart_timer_setup                  # scheduled restart (if enabled)
    rm -f "$WM_WATCHDOG_STATE" 2>/dev/null   # fresh apply clears any fail-open state
    warp_trace_ip >/dev/null 2>&1 || true   # warm the exit-IP cache for the header
}

apply_pretty() {
    banner
    printf '\n %sApplying%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
    if ! warp_is_up; then
        printf ' %sStarting WARP...%s\n' "$C_GRAY" "$C_RESET"
        warp_up || { printf ' %sWARP could not start (rate-limited?). WARP → Presets → Import WARP Account.%s\n' "$C_RED" "$C_RESET"; pause; return; }
    fi

    enabled_summary
    echo
    _sync_custom_provider
    if singbox_reload; then
        routing_installed || routing_apply
        routing_load_exclusions
        watchdog_service_setup
        rm -f "$WM_WATCHDOG_STATE" 2>/dev/null
        warp_trace_ip >/dev/null 2>&1 || true   # warm the exit-IP cache for the header
        printf ' %sApplied. Selected services route through WARP (apps + web).%s\n' "$C_GREEN" "$C_RESET"
    else
        printf ' %sFailed to apply — see the error above.%s\n' "$C_RED" "$C_RESET"
    fi
    pause
}

# =========================================================================
# Custom domains
# =========================================================================
menu_custom_domains() {
    while true; do
        banner
        printf '\n %sCustom Domains%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
        if [[ -s "$WM_CUSTOM_FILE" ]] && grep -qvE '^[[:space:]]*(#|$)' "$WM_CUSTOM_FILE"; then
            grep -nvE '^[[:space:]]*(#|$)' "$WM_CUSTOM_FILE" | sed 's/^/   /'
        else
            printf '   %s(none)%s\n' "$C_DIM" "$C_RESET"
        fi
        printf '\n %s+%s add   %s-%s remove   %s0%s back & apply\n\n' \
            "$C_PRIMARY" "$C_RESET" "$C_PRIMARY" "$C_RESET" "$C_PRIMARY" "$C_RESET"
        read -rp " > " ch
        case "$ch" in
            0|"") apply_pretty; return ;;
            +)  read -rp " Domain: " d; [[ -n "$d" ]] && echo "$d" >>"$WM_CUSTOM_FILE" ;;
            -)  read -rp " Domain to remove: " d
                [[ -n "$d" ]] && { grep -vxF "$d" "$WM_CUSTOM_FILE" >"${WM_CUSTOM_FILE}.t" 2>/dev/null; mv -f "${WM_CUSTOM_FILE}.t" "$WM_CUSTOM_FILE"; } ;;
        esac
    done
}

# =========================================================================
# White Lists — domains the ad blocker must never block
# =========================================================================
# Self-contained: it rebuilds the list on the way out, so it works the same whether
# it is opened from the WARP menu or anywhere else.
menu_whitelist() {
    local dirty=0
    while true; do
        banner
        printf '\n %sWhite Lists%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
        printf ' %sDomains here are never blocked by the ad blocker.%s\n' "$C_GRAY" "$C_RESET"
        printf ' %sAdd one if a site breaks while the ad blocker is on.%s\n\n' "$C_GRAY" "$C_RESET"
        if [[ -s "$WM_ADBLOCK_WHITELIST" ]] && grep -qvE '^[[:space:]]*(#|$)' "$WM_ADBLOCK_WHITELIST"; then
            grep -nvE '^[[:space:]]*(#|$)' "$WM_ADBLOCK_WHITELIST" | sed 's/^/   /'
        else
            printf '   %s(none — built-in safe domains are always protected)%s\n' "$C_DIM" "$C_RESET"
        fi
        printf '\n %s+%s add   %s-%s remove   %s0%s back\n\n' \
            "$C_PRIMARY" "$C_RESET" "$C_PRIMARY" "$C_RESET" "$C_PRIMARY" "$C_RESET"
        read -rp " > " ch
        case "$ch" in
            0|"")
                # a changed allow list only takes effect after a rebuild + reload
                if [[ "$dirty" -eq 1 ]] && adblock_is_enabled; then
                    printf '\n %sApplying...%s\n' "$C_GRAY" "$C_RESET"
                    adblock_refresh >/dev/null 2>&1 \
                        && printf ' %sApplied.%s\n' "$C_GREEN" "$C_RESET" \
                        || printf ' %sCould not apply — try Ad Blocker → Update list.%s\n' "$C_RED" "$C_RESET"
                    sleep 1
                fi
                return ;;
            +) read -rp " Domain to allow: " d
               [[ -n "$d" ]] && { adblock_whitelist_add "$d"; dirty=1; } ;;
            -) read -rp " Domain to remove: " d
               [[ -n "$d" ]] && { adblock_whitelist_remove "$d"; dirty=1; } ;;
        esac
    done
}

# =========================================================================
# Ad Blocker
# =========================================================================

menu_adblock() {
    while true; do
        banner
        printf '\n %sAd Blocker%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
        if adblock_is_enabled; then
            printf '   Status    %s● on%s\n' "$C_GREEN" "$C_RESET"
        else
            printf '   Status    %s○ off%s\n' "$C_GRAY" "$C_RESET"
        fi
        if adblock_has_list; then
            printf '   Blocked   %s%s%s domains\n' "$C_WHITE" "$(adblock_count)" "$C_RESET"
            printf '   Updated   %s\n' "$(adblock_last_update)"
        else
            printf '   List      %s(not downloaded yet)%s\n' "$C_DIM" "$C_RESET"
        fi
        printf '\n %sBlocks ads and trackers for everyone using this server,%s\n' "$C_GRAY" "$C_RESET"
        printf ' %susing the AdGuard DNS filter. No extra service runs.%s\n' "$C_GRAY" "$C_RESET"
        printf '\n   %st%s  Turn %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" "$(adblock_is_enabled && echo off || echo on)"
        printf '   %su%s  Update list now\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s0%s  Back\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '\n %sA blocked site is fixed under WARP → White Lists.%s\n\n' "$C_DIM" "$C_RESET"
        read -rp " > " ch
        case "$ch" in
            t|T)
                if adblock_is_enabled; then
                    adblock_disable
                    systemctl disable --now "$WM_ADBLOCK_TIMER" >/dev/null 2>&1 || true
                    printf '\n %sTurning off...%s\n' "$C_GRAY" "$C_RESET"
                    singbox_reload >/dev/null 2>&1 && printf ' %sAd blocker is off.%s\n' "$C_GREEN" "$C_RESET" \
                        || printf ' %sCould not reload the engine.%s\n' "$C_RED" "$C_RESET"
                else
                    adblock_enable
                    # first run has no list yet: fetch it before touching the engine
                    if ! adblock_has_list; then
                        printf '\n %sDownloading the ad list (this takes a moment)...%s\n' "$C_GRAY" "$C_RESET"
                        if ! adblock_build; then
                            adblock_disable
                            printf ' %sCould not build the list — ad blocker stays off.%s\n' "$C_RED" "$C_RESET"
                            pause; continue
                        fi
                    fi
                    adblock_timer_setup
                    printf '\n %sEnabling...%s\n' "$C_GRAY" "$C_RESET"
                    if singbox_reload >/dev/null 2>&1; then
                        printf ' %sAd blocker is on (%s domains).%s\n' "$C_GREEN" "$(adblock_count)" "$C_RESET"
                    else
                        adblock_disable
                        printf ' %sEngine rejected the config — ad blocker turned back off.%s\n' "$C_RED" "$C_RESET"
                        singbox_reload >/dev/null 2>&1
                    fi
                fi
                pause ;;
            u|U)
                printf '\n %sRefreshing the ad list...%s\n' "$C_GRAY" "$C_RESET"
                if adblock_refresh; then printf ' %sUpdated: %s domains.%s\n' "$C_GREEN" "$(adblock_count)" "$C_RESET"
                else printf ' %sUpdate failed — the previous list is still in use.%s\n' "$C_RED" "$C_RESET"; fi
                pause ;;
            0|"") return ;;
        esac
    done
}

# =========================================================================
# Connection
# =========================================================================
action_change_ip() {
    banner
    printf '\n %sChange IP%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
    printf ' Current IP: %s\n\n' "$(warp_trace_ip)"
    printf ' %sRegisters a new WARP account and walks a few Cloudflare entry points,%s\n' "$C_GRAY" "$C_RESET"
    printf ' %skeeping the first one that is alive and gives a different exit.%s\n' "$C_GRAY" "$C_RESET"
    printf ' %sSelected services flow directly while this runs (about a minute).%s\n' "$C_GRAY" "$C_RESET"
    read -rp $'\n Get a new WARP IP? [y/N]: ' yn
    [[ "$yn" =~ ^[Yy]$ ]] || { echo " Cancelled."; pause; return; }
    echo
    local rc=0
    warp_change_ip || rc=$?
    singbox_reload >/dev/null 2>&1 || true
    echo
    if [[ "$rc" -ne 0 ]]; then
        printf ' %sCould not change the IP — the previous account and endpoint are back.%s\n' "$C_RED" "$C_RESET"
    elif [[ -n "$WARP_OLD_IP" && "$WARP_NEW_IP" == "$WARP_OLD_IP" ]]; then
        # Say it plainly instead of reporting a change that did not happen.
        printf ' %sStill %s.%s\n' "$C_YELLOW" "$WARP_NEW_IP" "$C_RESET"
        printf ' %sThe account is new and the tunnel is healthy, but Cloudflare put this%s\n' "$C_GRAY" "$C_RESET"
        printf ' %sserver back on the same edge. Free WARP draws the exit from a pool tied%s\n' "$C_GRAY" "$C_RESET"
        printf ' %sto the nearest datacenter, so a small pool can return the same address.%s\n' "$C_GRAY" "$C_RESET"
        printf ' %sTrying again may help; a WARP+ license widens the pool.%s\n' "$C_GRAY" "$C_RESET"
    else
        printf ' %sNew IP: %s%s   %s(was %s)%s\n' \
            "$C_GREEN" "$WARP_NEW_IP" "$C_RESET" "$C_GRAY" "${WARP_OLD_IP:-unknown}" "$C_RESET"
    fi
    echo; warp_location | sed 's/^/   /'
    pause
}

menu_quic() {
    while true; do
        banner
        local m; m="$(routing_quic_mode)"
        printf '\n %sQUIC handling%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
        printf ' How the engine deals with UDP 443 (HTTP/3). Apps work either way —\n'
        printf ' in light mode they fall back to TCP, which is what goes through WARP.\n\n'
        if [[ "$m" == light ]]; then
            printf '   Mode  %slight%s  — QUIC dropped, engine handles TCP only\n' "$C_GREEN" "$C_RESET"
            printf '   %sLowest load and fewest moving parts on a busy relay.%s\n' "$C_GRAY" "$C_RESET"
        else
            printf '   Mode  %sroute%s  — QUIC goes through the engine\n' "$C_WHITE" "$C_RESET"
            printf '   %sKeeps QUIC working for everything except the selected services;%s\n' "$C_GRAY" "$C_RESET"
            printf '   %scosts more CPU/memory because every UDP session is tracked.%s\n' "$C_GRAY" "$C_RESET"
        fi
        printf '\n   %ss%s  Switch to %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" "$([[ "$m" == light ]] && echo route || echo light)"
        printf '   %s0%s  Back\n\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        read -rp " > " ch
        case "$ch" in
            s|S) if [[ "$m" == light ]]; then conf_set quic_mode route; else conf_set quic_mode light; fi
                 printf '\n %sApplying...%s\n' "$C_GRAY" "$C_RESET"
                 if singbox_reload >/dev/null 2>&1; then
                     routing_installed && routing_apply >/dev/null 2>&1
                     routing_load_exclusions
                     printf ' %sQUIC mode is now %s.%s\n' "$C_GREEN" "$(routing_quic_mode)" "$C_RESET"
                 else
                     printf ' %sCould not apply — check Status.%s\n' "$C_RED" "$C_RESET"
                 fi
                 pause ;;
            0|"") return ;;
        esac
    done
}

menu_ipcheck() {
    while true; do
        banner
        printf '\n %sAuto IP Health%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
        printf ' Checks in the background that the WARP exit IP actually works,\n'
        printf ' and gets a new one automatically when it does not.\n\n'
        if ipcheck_is_enabled; then
            printf '   Status    %s● on%s\n' "$C_GREEN" "$C_RESET"
        else
            printf '   Status    %s○ off%s\n' "$C_GRAY" "$C_RESET"
        fi
        printf '   Checks    every 10 minutes\n'
        printf '   Rotations %s used today (max %s)\n' "$(_ipcheck_rotations_today)" "$(_ipcheck_max_per_day)"
        printf '   Bad locs  %s\n' "$(_ipcheck_bad_locs)"
        printf '\n %sA new IP is only requested when the tunnel is up, the server''s own\n' "$C_GRAY"
        printf ' internet works, and the exit is really dead or in a blocked region —\n'
        printf ' so a brief outage can never burn through Cloudflare''s limits.%s\n' "$C_RESET"
        printf '\n   %st%s  Turn %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" "$(ipcheck_is_enabled && echo off || echo on)"
        printf '   %sc%s  Check now\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s0%s  Back\n\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        read -rp " > " ch
        case "$ch" in
            t|T) if ipcheck_is_enabled; then ipcheck_disable; else ipcheck_enable; fi
                 ipcheck_timer_setup
                 printf '\n %sAuto IP health is %s.%s\n' "$C_GREEN" "$(ipcheck_is_enabled && echo on || echo off)" "$C_RESET"
                 pause ;;
            c|C) printf '\n %sChecking the WARP exit...%s\n' "$C_GRAY" "$C_RESET"
                 if ipcheck_is_enabled; then ipcheck_run
                 else printf ' %sTurn it on first (or use Change IP for a one-off).%s\n' "$C_YELLOW" "$C_RESET"; fi
                 printf ' Exit IP: %s\n' "$(warp_trace_ip)"
                 pause ;;
            0|"") return ;;
        esac
    done
}

menu_license() {
    while true; do
        banner
        local cur; cur="$(conf_get license_key)"
        printf '\n %sWARP+ License%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
        if [[ -n "$cur" ]]; then
            printf ' Current: %s%s%s   (plan: %s)\n' "$C_GREEN" "${cur:0:8}…${cur: -4}" "$C_RESET" "$(warp_plan)"
        else
            printf ' Current: %s(none — free WARP)%s\n' "$C_DIM" "$C_RESET"
        fi
        printf '\n %ss%s set/change   %sc%s clear   %s0%s back\n\n' \
            "$C_PRIMARY" "$C_RESET" "$C_PRIMARY" "$C_RESET" "$C_PRIMARY" "$C_RESET"
        read -rp " > " ch
        case "$ch" in
            s|S) read -rp " WARP+ key: " key
                 [[ -n "$key" ]] && { warp_apply_license "$key" && { warp_up; singbox_reload; }; pause; } ;;
            c|C) warp_clear_license; pause ;;
            0|"") return ;;
        esac
    done
}

action_status() {
    banner
    status_line
    echo
    printf ' %sPlan%s        %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" "$(warp_is_up && warp_plan || echo '-')"
    printf ' %sEngine%s      sing-box %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" "$(singbox_is_up && echo 'running' || echo 'stopped')"
    printf ' %sRedirect%s    %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" "$(routing_installed && echo 'active (TPROXY TCP 80/443 + UDP 443 → sing-box)' || echo 'inactive')"
    if adblock_is_enabled; then
        printf ' %sAd Blocker%s  on — %s domains (updated %s)\n' "$C_PRIMARY$C_BOLD" "$C_RESET" "$(adblock_count)" "$(adblock_last_update)"
    else
        printf ' %sAd Blocker%s  off\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
    fi
    echo
    printf ' %sConnectivity%s\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
    printf '   Server direct : %s\n' "$(curl -s --connect-timeout 4 --max-time 8 "$CF_TRACE_URL" 2>/dev/null | awk -F= '/^ip=/{print $2}')"
    printf '   Via WARP      : %s\n' "$(warp_trace_ip)"
    echo
    printf ' %sLocation%s\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
    warp_location | sed 's/^/   /'
    echo
    printf ' %sEnabled services%s\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
    enabled_summary
    pause
}

# Restart the tunnel only. The engine config depends on WARP's health (it degrades
# to direct when there is no handshake), so it is rebuilt afterwards either way.
action_restart_warp() {
    banner
    printf '\n %sRestart WARP%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
    wm_maintenance_begin
    if warp_is_up; then warp_restart; else warp_up; fi
    if warp_is_up; then
        printf ' %sWARP is up. Exit IP: %s%s\n' "$C_GREEN" "$(warp_trace_ip)" "$C_RESET"
    else
        printf ' %sWARP did not come up (rate-limited?). Try Presets → Import WARP Account.%s\n' "$C_RED" "$C_RESET"
    fi
    singbox_reload >/dev/null 2>&1 || printf ' %sThe engine could not be reloaded — check Status.%s\n' "$C_RED" "$C_RESET"
    wm_maintenance_end
    pause
}

# Everything: tunnel, engine, redirect rules and the background timers.
action_restart_all() {
    banner
    printf '\n %sRestart All Services%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
    printf ' %sWARP, the routing engine, the redirect rules and the timers.%s\n\n' "$C_GRAY" "$C_RESET"
    wm_maintenance_begin
    if warp_is_up; then warp_restart; fi
    if engine_apply; then
        printf ' %sAll services restarted.%s\n' "$C_GREEN" "$C_RESET"
    else
        printf ' %sSomething failed — check WARP → Status.%s\n' "$C_RED" "$C_RESET"
    fi
    wm_maintenance_end
    pause
}

action_import_account() {
    banner
    printf '\n %sImport WARP account%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
    printf ' Use this if registration is rate-limited (429) on this server.\n'
    printf ' Copy %swgcf-account.toml%s from a working server, then give its path.\n\n' "$C_WHITE" "$C_RESET"
    printf ' %sThis moves the WARP identity (and its exit IP), not your settings —%s\n' "$C_GRAY" "$C_RESET"
    printf ' %ssettings travel as a preset.%s\n\n' "$C_GRAY" "$C_RESET"
    read -rp " Path to wgcf-account.toml: " f
    [[ -n "$f" ]] || { echo " Cancelled."; pause; return; }
    if warp_import_account "$f"; then engine_apply; fi
    pause
}

# =========================================================================
# Automation
# =========================================================================
menu_autorestart() {
    while true; do
        banner
        printf '\n %sAuto Restart%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
        printf ' Restarts WARP and the engine on a schedule, so a tunnel that has\n'
        printf ' slowly gone stale fixes itself without anyone watching.\n\n'
        if autorestart_is_enabled; then
            printf '   Status    %s● on%s\n' "$C_GREEN" "$C_RESET"
        else
            printf '   Status    %s○ off%s\n' "$C_GRAY" "$C_RESET"
        fi
        printf '   Every     %s hours\n' "$(autorestart_interval)"
        printf '   Next run  %s\n' "$(autorestart_next_run)"
        printf '\n %sThe redirect rules come down first, so traffic flows directly%s\n' "$C_GRAY" "$C_RESET"
        printf ' %sduring the restart instead of into a half-stopped engine.%s\n' "$C_GRAY" "$C_RESET"
        printf '\n   %st%s  Turn %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" "$(autorestart_is_enabled && echo off || echo on)"
        printf '   %si%s  Change the interval\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %sr%s  Run one now\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s0%s  Back\n\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        read -rp " > " ch
        case "$ch" in
            t|T) if autorestart_is_enabled; then autorestart_disable; else autorestart_enable; fi
                 autorestart_timer_setup
                 printf '\n %sAuto restart is %s.%s\n' "$C_GREEN" "$(autorestart_is_enabled && echo on || echo off)" "$C_RESET"
                 pause ;;
            i|I) read -rp " Restart every how many hours? [1-168]: " h
                 if autorestart_set_interval "$h"; then
                     autorestart_timer_setup
                     printf ' %sInterval set to %s hours.%s\n' "$C_GREEN" "$(autorestart_interval)" "$C_RESET"
                 else
                     printf ' %sEnter a whole number of hours between 1 and 168.%s\n' "$C_RED" "$C_RESET"
                 fi
                 pause ;;
            r|R) printf '\n %sRestarting now...%s\n' "$C_GRAY" "$C_RESET"
                 # same guard as the timer: tell the watchdog this gap is planned
                 wm_maintenance_begin
                 if warp_is_up; then warp_restart; fi
                 engine_apply && printf ' %sDone.%s\n' "$C_GREEN" "$C_RESET" \
                              || printf ' %sSomething failed — check Status.%s\n' "$C_RED" "$C_RESET"
                 wm_maintenance_end
                 pause ;;
            0|"") return ;;
        esac
    done
}

menu_automation() {
    while true; do
        banner
        printf '\n %sAutomation%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
        printf '   %s1%s  Auto Restart  %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" \
            "$(autorestart_is_enabled \
                && printf '%s● on%s %severy %sh%s' "$C_GREEN" "$C_RESET" "$C_GRAY" "$(autorestart_interval)" "$C_RESET" \
                || printf '%s○ off%s' "$C_GRAY" "$C_RESET")"
        printf '   %s2%s  Refresh Routes\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s0%s  Back\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        read -rp $'\n > ' ch
        case "$ch" in
            1) menu_autorestart ;;
            2) apply_pretty ;;
            0|"") return ;;
        esac
    done
}

# =========================================================================
# Presets — carry one server's settings to the next
# =========================================================================
action_export_preset() {
    # The code is encoded, not encrypted — anyone holding it can read it back. So
    # the WARP+ key travels only when you say so, and a code without it is safe to
    # paste anywhere.
    local mode="" token
    while true; do
        token="$(preset_export_token "$mode")"
        banner
        printf '\n %sExport Preset%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
        if [[ -z "$token" ]]; then
            printf ' %sCould not build the preset code.%s\n' "$C_RED" "$C_RESET"
            pause; return
        fi
        printf ' %sThis code carries everything you picked on this server:%s\n\n' "$C_GRAY" "$C_RESET"
        printf '   Services       %s\n' "$(grep -cvE '^[[:space:]]*(#|$)' "$WM_ENABLED_FILE" 2>/dev/null || echo 0)"
        printf '   Custom domains %s\n' "$(grep -cvE '^[[:space:]]*(#|$)' "$WM_CUSTOM_FILE" 2>/dev/null || echo 0)"
        printf '   White list     %s\n' "$(grep -cvE '^[[:space:]]*(#|$)' "$WM_ADBLOCK_WHITELIST" 2>/dev/null || echo 0)"
        printf '   Settings       QUIC, ad blocker, auto IP health, auto restart\n'
        if ! preset_has_license; then
            printf '   WARP+ license  %s(none set on this server)%s\n' "$C_DIM" "$C_RESET"
        elif [[ "$mode" == nolicense ]]; then
            printf '   WARP+ license  %snot included%s\n' "$C_GRAY" "$C_RESET"
        else
            printf '   WARP+ license  %sincluded%s\n' "$C_YELLOW" "$C_RESET"
        fi
        echo; hr
        printf '%s%s%s\n' "$C_WHITE" "$token" "$C_RESET"
        hr
        printf '\n %sCopy the whole code and paste it into Import Preset on your other%s\n' "$C_GRAY" "$C_RESET"
        printf ' %sservers — they end up with exactly these services enabled.%s\n' "$C_GRAY" "$C_RESET"
        if preset_has_license && [[ "$mode" != nolicense ]]; then
            printf '\n %sThe code is encoded, not encrypted: whoever has it can read the%s\n' "$C_YELLOW" "$C_RESET"
            printf ' %sWARP+ key out of it. Treat it like a password, or press l.%s\n' "$C_YELLOW" "$C_RESET"
        fi
        printf '\n   %ss%s  also save it to a file\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        if preset_has_license; then
            printf '   %sl%s  %s the WARP+ license\n' "$C_PRIMARY$C_BOLD" "$C_RESET" \
                "$([[ "$mode" == nolicense ]] && echo include || echo 'leave out')"
        fi
        printf '   %s0%s  Back\n\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        read -rp " > " ch
        case "$ch" in
            l|L) [[ "$mode" == nolicense ]] && mode="" || mode="nolicense" ;;
            s|S) local def dest; def="$(preset_default_path)"
                 read -rp " Save to [${def}]: " dest
                 [[ -z "$dest" ]] && dest="$def"
                 if preset_export_to "$dest" "$mode"; then
                     printf ' %sSaved to %s%s\n' "$C_GREEN" "$dest" "$C_RESET"
                 else
                     printf ' %sCould not write %s.%s\n' "$C_RED" "$dest" "$C_RESET"
                 fi
                 pause ;;
            0|"") return ;;
        esac
    done
}

action_import_preset() {
    banner
    printf '\n %sImport Preset%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
    printf ' %sPaste the code from another server (a file path also works).%s\n' "$C_GRAY" "$C_RESET"
    printf ' %sThis replaces the selected services, custom domains and white list%s\n' "$C_GRAY" "$C_RESET"
    printf ' %son this server with exactly what the code says.%s\n\n' "$C_GRAY" "$C_RESET"
    read -rp " Code or path: " src
    [[ -n "$src" ]] || { echo " Cancelled."; pause; return; }

    local f
    if ! f="$(preset_resolve "$src")"; then
        printf '\n %sThat is not a valid preset code or file.%s\n' "$C_RED" "$C_RESET"
        printf ' %sA code starts with WMP1. — make sure the whole thing was pasted.%s\n' "$C_GRAY" "$C_RESET"
        pause; return
    fi
    printf '\n %sThe preset contains:%s\n' "$C_WHITE" "$C_RESET"
    preset_summary "$f"
    read -rp $'\n Apply it? [y/N]: ' yn
    if [[ ! "$yn" =~ ^[Yy]$ ]]; then preset_release "$f" "$src"; echo " Cancelled."; pause; return; fi

    local ok=0
    preset_import_payload "$f" && ok=1
    preset_release "$f" "$src"
    if [[ "$ok" -eq 1 ]]; then
        printf '\n %sImported. Applying...%s\n\n' "$C_GREEN" "$C_RESET"
        # settings from the preset only take effect once the engine is rebuilt
        adblock_timer_setup; ipcheck_timer_setup; autorestart_timer_setup
        if engine_apply; then printf ' %sApplied — this server now matches the preset.%s\n' "$C_GREEN" "$C_RESET"
        else printf ' %sImported, but the engine did not come back — check Status.%s\n' "$C_RED" "$C_RESET"; fi
    else
        printf '\n %sImport failed.%s\n' "$C_RED" "$C_RESET"
    fi
    pause
}

menu_presets() {
    while true; do
        banner
        printf '\n %sPresets%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
        printf ' %sSet one server up the way you want it, then carry it to the rest.%s\n\n' "$C_GRAY" "$C_RESET"
        printf '   %s1%s  Export Preset\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s2%s  Import Preset\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s3%s  Import WARP Account  %s(when registration is 429-limited)%s\n' \
            "$C_PRIMARY$C_BOLD" "$C_RESET" "$C_DIM" "$C_RESET"
        printf '   %s0%s  Back\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        read -rp $'\n > ' ch
        case "$ch" in
            1) action_export_preset ;;
            2) action_import_preset ;;
            3) action_import_account ;;
            0|"") return ;;
        esac
    done
}

# =========================================================================
# WARP submenu — everything that is about the tunnel itself
# =========================================================================
menu_connection() {
    while true; do
        banner
        printf '\n %sConnection%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
        printf '   %s1%s  Change IP\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s2%s  Auto IP Health  %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" \
            "$(ipcheck_is_enabled && printf '%s● on%s' "$C_GREEN" "$C_RESET" || printf '%s○ off%s' "$C_GRAY" "$C_RESET")"
        printf '   %s3%s  QUIC Handling  %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" \
            "$([[ "$(routing_quic_mode)" == light ]] && printf '%slight%s' "$C_GREEN" "$C_RESET" || printf '%sroute%s' "$C_GRAY" "$C_RESET")"
        printf '   %s0%s  Back\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        read -rp $'\n > ' ch
        case "$ch" in
            1) action_change_ip ;;
            2) menu_ipcheck ;;
            3) menu_quic ;;
            0|"") return ;;
        esac
    done
}

menu_warp() {
    while true; do
        banner
        status_line
        printf '   %s1%s  Choose Services\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s2%s  Custom Domains\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s3%s  White Lists\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s4%s  Connection\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s5%s  Automation\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s6%s  Presets\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s7%s  WARP+ License\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s8%s  Status\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s9%s  Restart WARP\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        printf '   %s0%s  Back\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
        read -rp $'\n > ' ch
        case "$ch" in
            1) menu_services ;;
            2) menu_custom_domains ;;
            3) menu_whitelist ;;
            4) menu_connection ;;
            5) menu_automation ;;
            6) menu_presets ;;
            7) menu_license ;;
            8) action_status ;;
            9) action_restart_warp ;;
            0|"") return ;;
        esac
    done
}

# =========================================================================
# Update — re-run the online installer (code only; config is preserved)
# =========================================================================
WM_UPDATE_URL="https://raw.githubusercontent.com/AminMGMT/WARP-Manager/main/setup.sh"

action_update() {
    banner
    printf '\n %sUpdate WARP Manager%s\n\n' "$C_BOLD$C_PRIMARY" "$C_RESET"
    printf ' Pulls the latest CLI + engine and re-applies it.\n'
    printf ' %sYour configuration is kept:%s enabled services, WARP account & exit IP,\n' "$C_GRAY" "$C_RESET"
    printf ' WARP+ license and custom domains are all preserved.\n\n'
    read -rp $' Update now? [y/N]: ' yn
    [[ "$yn" =~ ^[Yy]$ ]] || { echo " Cancelled."; pause; return; }

    local tmp; tmp="$(mktemp)"
    printf '\n %sDownloading updater...%s\n' "$C_GRAY" "$C_RESET"
    if ! curl -fsSL --connect-timeout 20 "$WM_UPDATE_URL" -o "$tmp"; then
        rm -f "$tmp"
        printf ' %sCould not download the updater (network/GitHub blocked?).%s\n' "$C_RED" "$C_RESET"
        pause; return
    fi
    printf ' %sUpdating — the menu will reopen when it finishes.%s\n\n' "$C_GRAY" "$C_RESET"
    # Replace this process: the installer overwrites the very script we are running,
    # so we must NOT return into it. The installer re-opens the menu itself.
    exec bash "$tmp"
}

# =========================================================================
# Uninstall — full purge
# =========================================================================
action_uninstall() {
    banner
    printf '\n %sUninstall — removes EVERYTHING%s\n\n' "$C_BOLD$C_RED" "$C_RESET"
    printf ' %sThis deletes the WARP interface, WARP account, all rules,\n config, systemd units, and the warp-manager files.%s\n\n' "$C_GRAY" "$C_RESET"
    read -rp " Type 'yes' to confirm: " yn
    [[ "$yn" == "yes" ]] || { echo " Cancelled."; pause; return; }
    purge_everything
    printf '\n %sDone. WARP Manager has been completely removed.%s\n\n' "$C_GREEN" "$C_RESET"
    exit 0
}

purge_everything() {
    systemctl disable --now warp-manager-boot.service >/dev/null 2>&1 || true
    systemctl disable --now "$WM_SINGBOX_SERVICE" >/dev/null 2>&1 || true
    systemctl disable --now "$WM_WATCHDOG_TIMER" >/dev/null 2>&1 || true
    systemctl disable --now "$WM_ADBLOCK_TIMER" >/dev/null 2>&1 || true
    systemctl disable --now "$WM_IPCHECK_TIMER" >/dev/null 2>&1 || true
    systemctl disable --now "$WM_AUTORESTART_TIMER" >/dev/null 2>&1 || true
    rm -f "/etc/systemd/system/${WM_SINGBOX_SERVICE}" /etc/systemd/system/warp-manager-boot.service \
          "/etc/systemd/system/${WM_WATCHDOG_SERVICE}" "/etc/systemd/system/${WM_WATCHDOG_TIMER}" \
          "/etc/systemd/system/${WM_ADBLOCK_SERVICE}" "/etc/systemd/system/${WM_ADBLOCK_TIMER}" \
          "/etc/systemd/system/${WM_IPCHECK_SERVICE}" "/etc/systemd/system/${WM_IPCHECK_TIMER}" \
          "/etc/systemd/system/${WM_AUTORESTART_SERVICE}" "/etc/systemd/system/${WM_AUTORESTART_TIMER}"
    routing_teardown 2>/dev/null || true
    warp_down 2>/dev/null || true
    systemctl disable --now "wg-quick@${WM_IFACE}" >/dev/null 2>&1 || true
    rm -f "$WM_WG_CONF" /etc/sysctl.d/99-warp-manager.conf
    rm -f /usr/local/bin/warp-manager /usr/local/bin/wm /usr/local/bin/wgcf "$WM_SINGBOX_BIN"
    systemctl daemon-reload >/dev/null 2>&1 || true
    sysctl --system >/dev/null 2>&1 || true
    rm -rf "$WM_CONF_DIR" "$WM_STATE_DIR" "$WM_ROOT"
}

# =========================================================================
# Non-interactive subcommands (systemd / scripts)
# =========================================================================
case "${1:-}" in
    --refresh)   require_root; engine_apply; exit $? ;;
    --up)        require_root; engine_apply; exit $? ;;
    --down)      require_root; routing_teardown; systemctl stop "$WM_SINGBOX_SERVICE" >/dev/null 2>&1; warp_down; exit $? ;;
    --change-ip) require_root; warp_change_ip && singbox_reload; exit $? ;;
    --import-account) require_root; warp_import_account "${2:-}" && engine_apply; exit $? ;;
    --location)  warp_location; exit 0 ;;
    --license)   require_root; warp_apply_license "${2:-}" && { warp_up; singbox_reload; }; exit $? ;;
    --status)    status_line; exit 0 ;;
    --watchdog)  watchdog_run; exit 0 ;;
    --adblock-update) require_root; adblock_refresh; exit $? ;;
    --ip-check)  require_root; ipcheck_run; exit 0 ;;
    --auto-restart) require_root; autorestart_run; exit 0 ;;
    # no FILE: print the token on stdout, so it pipes straight into another server:
    #   ssh b "warp-manager --import-preset $(ssh a warp-manager --export-preset)"
    --export-preset)
        require_root
        case "${2:-}" in
            "")            preset_export_token ;;
            --no-license)  preset_export_token nolicense ;;
            *)             preset_export_to "$2" "${3:-}" && echo "$2" ;;
        esac
        exit $? ;;
    --import-preset) require_root; preset_import "${2:-}" && { adblock_timer_setup; ipcheck_timer_setup; autorestart_timer_setup; engine_apply; }; exit $? ;;
    --update)    require_root; exec bash -c "$(curl -fsSL --connect-timeout 20 "$WM_UPDATE_URL")" ;;
    --purge)     require_root; purge_everything; exit 0 ;;
    -h|--help)
        cat <<EOF
WARP Manager
  warp-manager                run the interactive menu
  warp-manager --refresh      re-apply the engine (config + routes)
  warp-manager --up           bring WARP + sing-box + TPROXY up
  warp-manager --down         stop the engine (remove TPROXY, stop sing-box/WARP)
  warp-manager --change-ip    get a new WARP IP
  warp-manager --import-account FILE  import a wgcf-account.toml from another server
  warp-manager --location     show WARP location
  warp-manager --license KEY  apply a WARP+ license
  warp-manager --adblock-update  refresh the ad blocker list now
  warp-manager --ip-check     check the WARP exit IP now (rotates it if bad)
  warp-manager --auto-restart run the scheduled restart now (no-op when disabled)
  warp-manager --export-preset        print this server's preset code
  warp-manager --export-preset --no-license   ...without the WARP+ key
  warp-manager --export-preset FILE   write the preset to a file instead
  warp-manager --import-preset CODE|FILE  apply a preset and restart the engine
  warp-manager --update       update to the latest version (keeps your config)
  warp-manager --purge        remove everything
EOF
        exit 0 ;;
esac

# =========================================================================
# Main menu
# =========================================================================
[[ "$(id -u)" -eq 0 ]] || die "Please run as root (sudo wm)."
ensure_dirs

while true; do
    banner
    status_line
    printf '   %s1%s  WARP %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" \
        "$(warp_is_up && printf '%s● ON%s' "$C_GREEN" "$C_RESET" || printf '%s○ OFF%s' "$C_RED" "$C_RESET")"
    printf '   %s2%s  Ad Blocker %s\n' "$C_PRIMARY$C_BOLD" "$C_RESET" \
        "$(adblock_is_enabled && printf '%s● ON%s' "$C_GREEN" "$C_RESET" || printf '%s○ OFF%s' "$C_GRAY" "$C_RESET")"
    printf '   %s3%s  Restart All Services\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
    printf '   %s4%s  Update\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
    printf '   %s5%s  Uninstall\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
    printf '   %s6%s  Exit\n' "$C_PRIMARY$C_BOLD" "$C_RESET"
    read -rp $'\n > ' choice
    case "$choice" in
        1) menu_warp ;;
        2) menu_adblock ;;
        3) action_restart_all ;;
        4) action_update ;;
        5) action_uninstall ;;
        6|q|Q|0) clear 2>/dev/null || true; exit 0 ;;
        *) ;;
    esac
done
